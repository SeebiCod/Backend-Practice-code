{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug auth-api",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-x", "tests/test_api.py"],
      "justMyCode": true
    }
  ]
}